{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Server (CodeLLDB)",
      "cargo": {
        "args": [
          "build",
          "--bin=api-lab-server",
          "--package=api-lab-server"
        ],
        "filter": {
          "name": "api-lab-server",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "8080",
        "DATABASE_URL": "postgres://root:root@localhost:5432/api_lab?sslmode=disable",
        "ENV_ENCRYPTION_KEY": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef",
        "RUST_LOG": "info,api_lab_server=debug,tower_http=debug"
      }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Run Server (Terminal)",
      "command": "cargo run -p api-lab-server",
      "cwd": "${workspaceFolder}"
    }
  ]
}
