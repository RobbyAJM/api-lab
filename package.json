{
  "name": "api-lab-monorepo",
  "private": true,
  "scripts": {
    "dev:desktop": "pnpm --filter @api-lab/desktop dev",
    "build:desktop": "pnpm --filter @api-lab/desktop build",
    "build:desktop:exe": "pnpm --filter @api-lab/desktop exec tauri build --no-bundle --features desktop",
    "server:run": "cargo run -p api-lab-server",
    "test:rust": "cargo test --workspace",
    "test:ts": "node --experimental-strip-types --test apps/desktop/src/utils/*.test.ts",
    "test": "cargo test --workspace && node --experimental-strip-types --test apps/desktop/src/utils/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
